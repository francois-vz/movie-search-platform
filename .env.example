# ============================================================================
# Movie Search Platform — environment configuration
# Copy to .env and adjust as needed:  cp .env.example .env
# NEVER commit the real .env (it is gitignored).
# ============================================================================

# ---- PostgreSQL / pgvector ----
POSTGRES_USER=movies
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=movies
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Convenience DSN used by the pipeline + MCP server
DATABASE_URL=postgresql://movies:change_me_local_only@postgres:5432/movies

# ---- Embedding model server (Ollama) ----
# Containerized Ollama reachable over the docker network (host port 8001 -> 11434).
EMBEDDING_BASE_URL=http://embeddings:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
# HTTP timeout for a single embedding request (first call can be slow while
# Ollama loads the model into memory).
EMBEDDING_TIMEOUT_SECONDS=60

# ---- Data pipeline ----
PIPELINE_VERSION=0.1.0
PIPELINE_LOG_LEVEL=INFO

# ---- Embedding Atlas (Part 5) ----
# Export path inside the atlas container. The entrypoint waits (ATLAS_WAIT=1)
# until movies.embedding is populated by the 1.5 loader.
ATLAS_EXPORT_PATH=/data/movies.parquet
ATLAS_WAIT=1

# ---- MCP server ----
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=sse
MCP_LOG_LEVEL=INFO
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# Search policy. Requests above MCP_TOP_K_MAX are clamped, not rejected.
MCP_TOP_K_MAX=50
# Rating floor applied when a query says "highly rated" / "critically acclaimed"
# without naming a number.
HIGH_IMDB_THRESHOLD=7.5

# ---- .NET API ----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
# fake = in-process fixtures (Part 4 without a live MCP server); mcp = SSE client
MCP_CLIENT=mcp
MCP_SERVER_URL=http://mcp-server:8000
# JWT signing (local dev only — use Secrets Manager in prod)
JWT_ISSUER=movie-search
JWT_AUDIENCE=movie-search-clients
JWT_SIGNING_KEY=change_me_min_32_chars_local_only_secret
JWT_EXPIRY_MINUTES=60
AUTH_READER_CLIENT_ID=reader
AUTH_READER_CLIENT_SECRET=reader-secret
AUTH_ADMIN_CLIENT_ID=admin
AUTH_ADMIN_CLIENT_SECRET=admin-secret
CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=30

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
