# ---- Secrets / env ----
.env
*.env
!.env.example
# Never commit AWS credentials. Put them in ~/.aws/ (outside this repo).
.aws/
**/credentials
*.pem
*.key
!*.pub

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.log

# ---- .NET ----
bin/
obj/
*.user
[Dd]ebug/
[Rr]elease/
TestResults/

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
# Keep lockfile tracked; ignore local override secrets if someone names them this way
secrets.auto.tfvars
*.secret.tfvars
# Backend config embeds the AWS account id (bucket name). Commit only the example.
backend.hcl
!backend.hcl.example

# ---- Data / artifacts ----
# Run artifacts land in <cwd>/reports; when the pipeline is run from pipeline/
# rather than in its container that is pipeline/reports.
pipeline/reports/
data/
*.parquet
atlas_export/
# Ignore runtime report artifacts but keep the living Section reports.
reports/*
!reports/section-1.md
!reports/section-2.md
!reports/section-3.md
!reports/section-4.md
!reports/section-5.md
!reports/section-6.md
# Executed plan per part, kept alongside the section reports.
!reports/plans/

# API log files (Serilog file sink)
api/**/logs/

# ---- Assessment source material (not our deliverable) ----
# The brief itself is Derivco's document; the export is a Cursor chat transcript.
senior-ai-engineer-assessment*.pdf
export.md

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
